# ==============================================================================
# GovAI Nexus - Production Python 3.12 FastAPI Dockerfile
# Optimized for High Concurrency, AI/ML Inference and Enterprise Security
# ==============================================================================

FROM python:3.12-slim AS base

# System hardening & dependencies
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PORT=8080

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    tesseract-ocr \
    tesseract-ocr-tam \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Non-privileged application user for security
RUN groupadd -g 10001 govai && \
    useradd -u 10000 -g govai -s /bin/bash -m govai_service

# Install Python requirements
COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r ./backend/requirements.txt

# Copy backend application source
COPY backend ./backend

# Create uploads directory and set permissions
RUN mkdir -p /app/uploads && chown -R govai_service:govai /app

USER govai_service

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "4", "--proxy-headers", "--forwarded-allow-ips", "*"]
